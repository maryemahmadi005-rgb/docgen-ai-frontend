# ============================================================
# README SYNC PLATFORM - ENVIRONMENT VARIABLES
# ============================================================


# ============================================================
# FLASK
# ============================================================

FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=change-this-to-a-long-random-secret-key

DEBUG=True

HOST=127.0.0.1
PORT=5000


# ============================================================
# DATABASE - XAMPP / MariaDB
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=readme_sync
DB_USER=root
DB_PASSWORD=

DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3307/readme_sync


# ============================================================
# GITHUB OAUTH
# ============================================================

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITHUB_REDIRECT_URI=http://127.0.0.1:5000/api/auth/github/callback


# ============================================================
# ENCRYPTION
#
# Used to encrypt:
#   - github_token
#   - webhook_secret
#
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================

ENCRYPTION_MASTER_KEY=FEpoXQ9RrvyFRdnE-MAzhSdh8_9-t_UWxT5n-pTGOF8=


# ============================================================
# GITHUB WEBHOOKS
# ============================================================

GITHUB_WEBHOOK_CALLBACK_URL=http://127.0.0.1:5000/api/webhooks/github

README_BOT_EMAIL=readme-bot@yourapp.io


# ============================================================
# GIT / REPOSITORIES
# ============================================================

CLONES_BASE_DIR=C:/readme-sync-clones

GIT_CLONE_DEPTH=1


# ============================================================
# OLLAMA
# ============================================================

OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_MODEL=llama3.2:3b

OLLAMA_TIMEOUT=300

OLLAMA_NUM_PREDICT=600

OLLAMA_TEMPERATURE=0.2

OLLAMA_JSON_TEMPERATURE=0.1

PROJECT_ANALYSIS_TIMEOUT=400


# ============================================================
# AI CIRCUIT BREAKER
# ============================================================

MAX_CONSECUTIVE_FAILURES=3

AVAILABILITY_TIMEOUT=2


# ============================================================
# CELERY / REDIS
# ============================================================

CELERY_BROKER_URL=redis://localhost:6379/0

CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ============================================================
# CORS
# ============================================================

FRONTEND_URL=http://localhost:5174

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

